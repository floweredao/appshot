    "Allow Appshot to control the browser in System Settings › Privacy & Security › Automation to include the whole page.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Appshot to control the browser in System Settings › Privacy & Security › Automation to include the whole page."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지 전체를 담으려면 시스템 설정 › 개인정보 보호 및 보안 › 자동화에서 Appshot이 브라우저를 제어하도록 허용해 주세요."
          }
        }
      }
    },

    "Accessibility permission is off, so window text could not be read.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission is off, so window text could not be read."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 권한이 꺼져 있어 창 글자를 읽지 못했어요."
          }
        }
      }
    },
    "Allow Appshot to control the browser in System Settings › Privacy & Security › Automation to include the whole page.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Appshot to control the browser in System Settings › Privacy & Security › Automation to include the whole page."

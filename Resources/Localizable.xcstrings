    "demo.page.body1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen UI is a small set of native-feeling components. Add the package, import it, and drop a button into any view."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen UI는 네이티브 느낌의 작은 컴포넌트 모음이에요. 패키지를 추가하고 불러온 뒤 아무 화면에나 버튼을 넣어 보세요."
          }
        }
      }
    },
    "demo.page.body2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every component follows the system appearance, Dynamic Type, and Reduce Motion out of the box."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 컴포넌트는 처음부터 시스템 화면 모드, 글자 크기, 동작 줄이기 설정을 따라요."
          }
        }
      }
    },
    "demo.page.tip": {

            "state": "translated",
            "value": "Appshot %@ 버전이 나왔어요"
          }
        }
      }
    },
    "Appshot Settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appshot Settings"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Appshot 설정"
          }
        }
      }
    },
    "Appshot brings the app to the front and pastes into its focused text field. Chat apps such as ChatGPT, Claude, and Codex accept “Image, then text” or “Files”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appshot brings the app to the front and pastes into its focused text field. Chat apps such as ChatGPT, Claude, and Codex accept “Image, then text” or “Files”."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Appshot이 앱을 앞으로 가져와 입력 중인 칸에 붙여 넣어요. ChatGPT, Claude, Codex 같은 대화 앱은 ‘이미지 다음 글자’나 ‘파일’을 받아요."
          }
        }
      }
    },
    "Appshot cannot replace itself at %@. Move Appshot to the Applications folder and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appshot cannot replace itself at %@. Move Appshot to the Applications folder and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 있는 Appshot을 바꿀 수 없어요. Appshot을 응용 프로그램 폴더로 옮긴 뒤 다시 해 주세요."
          }
        }
      }
    },
    "Appshot is up to date": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appshot is up to date"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Appshot이 최신 버전이에요"
          }
        }
      }
    },
    "Appshot is up to date.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appshot is up to date."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Appshot이 최신 버전이에요."
          }
        }
      }
    },
    "Appshot reads channels from the Discord app. Open a server in Discord once to add its channels.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appshot reads channels from the Discord app. Open a server in Discord once to add its channels."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스코드 앱에서 채널 목록을 읽어요. 디스코드에서 서버를 한 번 열면 그 서버의 채널이 추가돼요."
          }
        }
      }
    },
    "Appshot was not updated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appshot was not updated"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Appshot을 업데이트하지 않았어요"
          }
        }
      }
    },
    "Ask %@ about this window (optional)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask %@ about this window (optional)"
